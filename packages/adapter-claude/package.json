{
  "name": "@two-layer-cake/adapter-claude",
  "version": "1.0.0",
  "description": "Claude LLM adapter for two-layer-cake",
  "license": "MIT",
  "author": "George Le",
  "homepage": "https://github.com/GeorgeQLe/two-layer-cake#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeorgeQLe/two-layer-cake",
    "directory": "packages/adapter-claude"
  },
  "bugs": {
    "url": "https://github.com/GeorgeQLe/two-layer-cake/issues"
  },
  "keywords": [
    "ai",
    "claude",
    "anthropic",
    "llm",
    "adapter",
    "two-layer-cake"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0"
  },
  "peerDependencies": {
    "two-layer-cake": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.23.0",
    "two-layer-cake": "workspace:*"
  }
}
