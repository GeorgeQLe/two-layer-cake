{
  "name": "two-layer-cake",
  "version": "1.0.0",
  "description": "TypeScript SDK for building multi-agent AI applications with hierarchical planning and execution",
  "license": "MIT",
  "author": "George Le",
  "homepage": "https://github.com/GeorgeQLe/two-layer-cake#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeorgeQLe/two-layer-cake",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/GeorgeQLe/two-layer-cake/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "orchestrator",
    "llm",
    "planner",
    "dag",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./adapters/claude": {
      "import": {
        "types": "./dist/adapters/claude.d.ts",
        "default": "./dist/adapters/claude.mjs"
      },
      "require": {
        "types": "./dist/adapters/claude.d.cts",
        "default": "./dist/adapters/claude.js"
      }
    },
    "./adapters/openai": {
      "import": {
        "types": "./dist/adapters/openai.d.ts",
        "default": "./dist/adapters/openai.mjs"
      },
      "require": {
        "types": "./dist/adapters/openai.d.cts",
        "default": "./dist/adapters/openai.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.mjs"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && cp src/adapters/claude.d.ts.stub dist/adapters/claude.d.ts && cp src/adapters/claude.d.ts.stub dist/adapters/claude.d.cts && cp src/adapters/openai.d.ts.stub dist/adapters/openai.d.ts && cp src/adapters/openai.d.ts.stub dist/adapters/openai.d.cts",
    "test": "vitest run",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "@two-layer-cake/adapter-claude": "workspace:*",
    "@two-layer-cake/adapter-openai": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@two-layer-cake/adapter-claude": {
      "optional": true
    },
    "@two-layer-cake/adapter-openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
